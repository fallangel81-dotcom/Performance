@EndUserText.label : 'PA: Trace-Analyse Sitzung (Header)'
@AbapCatalog.enhancement.category : #EXTENSIBLE_ANY
@AbapCatalog.tableCategory : #TRANSPARENT
@AccessControl.authorizationCheck : #NOT_REQUIRED
define table zpa_trace_session {

  key mandt          : mandt not null;
  key session_id     : zpa_session_id not null;       " UUID (RAW 16)

  session_name       : zpa_session_name;              " Frei wählbarer Name
  trace_source       : zpa_trace_source;              " PTC | HANA | STAD | FILE
  system_id          : sysid;
  umgebung           : zpa_umgebung;                  " DEV | QAS | PRD
  modul              : zpa_modul;                     " FI | MM | SD | ...
  beschreibung       : zpa_beschreibung;

  " Zeitstempel
  trace_date_from    : dats;                          " Startdatum des Traces
  trace_time_from    : tims;                          " Startzeit des Traces
  trace_date_to      : dats;                          " Enddatum
  trace_time_to      : tims;                          " Endzeit
  erfasst_am         : dats;
  erfasst_um         : tims;
  erfasst_von        : uname;

  " Aggregierte Kennzahlen (beim Import befüllt)
  gesamt_laufzeit_us : zpa_laufzeit_us;               " Gesamtlaufzeit µs
  db_laufzeit_us     : zpa_laufzeit_us;               " Reine DB-Zeit µs
  anzahl_statements  : zpa_anzahl;                    " Anzahl SQL-Statements
  anzahl_findings    : zpa_anzahl;                    " Anzahl erkannter Findings

  " Verknüpfung mit PTC_DIRECTORY (bei source=PTC)
  ptc_guid           : ptc_directory_entry_guid;      " GUID aus PTC_DIRECTORY
  ptc_owner          : ptc_directory_entry_owner;     " Ersteller des ST05-Trace
  ptc_instance       : ptc_instance_name;

  session_status     : char1;                         " N=Neu A=Analysiert F=Fertig

}
