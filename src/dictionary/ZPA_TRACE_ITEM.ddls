@EndUserText.label : 'PA: Importierte Trace-Einzelsätze'
@AbapCatalog.enhancement.category : #EXTENSIBLE_ANY
@AbapCatalog.tableCategory : #TRANSPARENT
@AccessControl.authorizationCheck : #NOT_REQUIRED
define table zpa_trace_item {

  key mandt          : mandt not null;
  key session_id     : sysuuid_x16 not null;
  key item_seq       : abap.int4 not null;            " Laufende Nummer

  " Herkunft
  data_source        : abap.char(15);                 " PTC_MAIN | PTC_VALUEID | ...

  " SQL / Operation
  stmt_type          : abap.char(12);                 " SELECT | INSERT | SUMM_TAB | ...
  tabname            : tabname;                       " Primäre Tabelle / CDS-View
  @AbapCatalog.column.multitenancyType : #NONE
  objects_raw        : abap.string(0);                " Volltext OBJECT-Feld (JOIN)
  @AbapCatalog.column.multitenancyType : #NONE
  sql_text           : abap.string(0);                " SQL mit Feldnamen
  sql_hash           : abap.char(32);                 " HANA Statement Hash

  " Laufzeit
  laufzeit_us        : abap.int8;                     " Gesamtlaufzeit µs
  hana_proc_time_us  : abap.int8;                     " HANA Verarbeitungszeit µs
  hana_cpu_time_us   : abap.int8;                     " HANA CPU-Zeit µs
  hana_max_memory_kb : abap.int8;                     " HANA Max-Speicher kB

  " Datenmenge
  records_fetched    : abap.int4;                     " Gelesene Datensätze
  array_size         : abap.int4;                     " Array-Größe

  " Aggregierte Werte (aus IDENTICAL_RECORD)
  anzahl_exec        : abap.int4;                     " Anzahl Ausführungen
  avg_duration_us    : abap.int8;                     " Ø Laufzeit je Ausführung µs
  avg_rows           : abap.int4;                     " Ø Rows je Ausführung

  " Kontext
  program_name       : ptc_program_name;              " ABAP-Programm (CHAR 40)
  transaction        : ptc_transaction_code;          " Transaktionscode
  user_name          : ptc_user_name;                 " Benutzer
  wp_id              : ptc_wp_id;
  wp_type            : ptc_wp_type;
  return_code        : abap.int4;
  epp_root_id        : ptc_epp_root_id;

  " Tabelleninfo
  buffer_type        : st05_object_buffer_type;
  tabclass           : st05_object_type_;             " TRANSP | VIEW | CLUSTER | ...

  " Zeitstempel des Traces
  trace_date         : dats;
  trace_time         : tims;
  instance_nm        : ptc_instance_name;

  " Abgeleitete Felder
  has_where          : abap_bool;
  is_custom_code     : abap_bool;                     " Z* oder Y* Namensraum

}
