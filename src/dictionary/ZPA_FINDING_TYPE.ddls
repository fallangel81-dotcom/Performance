@EndUserText.label : 'PA: Finding-Typen Katalog (Customizing)'
@AbapCatalog.enhancement.category : #EXTENSIBLE_ANY
@AbapCatalog.tableCategory : #TRANSPARENT
@AccessControl.authorizationCheck : #NOT_REQUIRED
define table zpa_finding_type {

  key mandt          : mandt not null;
  key finding_type   : zpa_finding_type not null;

  beschreibung       : abap.char(80);
  kategorie          : zpa_kategorie;
  basis_score        : abap.int1;                     " 0-100
  aktiv              : abap_bool;

  " Schwellwerte
  schwelle_laufzeit  : abap.int8;                     " Mindestlaufzeit µs
  schwelle_anzahl    : abap.int4;                     " Mindestanzahl Ausführungen
  schwelle_rows      : abap.int4;                     " Mindest-Datensätze

  @AbapCatalog.column.multitenancyType : #NONE
  massnahme_vorlage  : abap.string(0);

}

"--------------------------------------------------------------------
" Initialbefüllung
" finding_type    | beschreibung                        | kat         | score | aktiv | laufzeit  | anzahl | rows
" SELECT_LOOP     | SELECT in ABAP-Schleife             | ABAP_LOGIK  |  80   | X     |         0 |      5 |     0
" FULL_SCAN       | Full Table Scan ohne Index          | DB_ACCESS   |  75   | X     |    100000 |      0 | 10000
" NO_WHERE        | SELECT ohne WHERE-Bedingung         | DB_ACCESS   |  85   | X     |         0 |      0 |   100
" HIGH_RUNTIME    | Hohe Einzellaufzeit                 | DB_ACCESS   |  70   | X     |   2000000 |      0 |     0
" EXPENSIVE_JOIN  | Teurer Multi-Table-JOIN             | DB_ACCESS   |  65   | X     |    500000 |      0 |  1000
" CDS_EXPENSIVE   | Teurer CDS-View-Zugriff             | CDS_ODATA   |  70   | X     |   1000000 |      0 |     0
" LOW_SELECT      | Geringe Selektivität (<5%)          | ABAP_LOGIK  |  60   | X     |         0 |      0 |   500
" DUPLICATE_SQL   | Identisches SQL mehrfach            | ABAP_LOGIK  |  55   | X     |         0 |      3 |     0
" ODATA_SLOW      | OData/Gateway hohe Laufzeit         | CDS_ODATA   |  75   | X     |   2000000 |      0 |     0
" RFC_SLOW        | RFC/BAPI hohe Laufzeit              | RFC_BAPI    |  70   | X     |   1000000 |      0 |     0
" TIME_ANOMALY    | DB/ABAP-Zeitverhältnis auffällig    | ARCHITEKTUR |  40   | X     |         0 |      0 |     0
" CLUSTER_ACCESS  | Cluster-/Pool-Tabellenzugriff       | ARCHITEKTUR |  50   | X     |         0 |      0 |     0
"--------------------------------------------------------------------
