@EndUserText.label : 'PA: Erkannte Performance-Findings'
@AbapCatalog.enhancement.category : #EXTENSIBLE_ANY
@AbapCatalog.tableCategory : #TRANSPARENT
@AccessControl.authorizationCheck : #NOT_REQUIRED
define table zpa_finding {

  key mandt          : mandt not null;
  key finding_id     : sysuuid_x16 not null;          " UUID

  " Zuordnung
  session_id         : sysuuid_x16;
  item_seq           : abap.int4;                     " Bezug auf ZPA_TRACE_ITEM

  " Klassifikation – die 4 eigenen Domänen mit Festwertlisten
  finding_type       : zpa_finding_type;              " SELECT_LOOP | FULL_SCAN | ...
  kategorie          : zpa_kategorie;                 " DB_ACCESS | ABAP_LOGIK | ...
  prioritaet         : zpa_prioritaet;                " KRITISCH | HOCH | MITTEL | ...
  score              : abap.int1;                     " 0-100

  " Fundstelle
  programm           : ptc_program_name;
  tabname            : tabname;
  @AbapCatalog.column.multitenancyType : #NONE
  sql_kurzform       : abap.string(0);
  sql_hash           : abap.char(32);

  " Messwerte
  laufzeit_us        : abap.int8;
  anzahl_exec        : abap.int4;
  datenmenge         : abap.int4;

  " Bewertung
  @AbapCatalog.column.multitenancyType : #NONE
  technische_ursache : abap.string(0);
  @AbapCatalog.column.multitenancyType : #NONE
  fachliche_einsch   : abap.string(0);
  @AbapCatalog.column.multitenancyType : #NONE
  empf_massnahme     : abap.string(0);
  optim_hebel        : zpa_opt_hebel;                 " HOCH | MITTEL | NIEDRIG
  is_custom_code     : abap_bool;

  " Aufrufhierarchie (JSON)
  @AbapCatalog.column.multitenancyType : #NONE
  call_hierarchy     : abap.string(0);

  " Status
  status             : abap.char(1);                  " O=Offen G=Gelöst I=Ignoriert
  bearbeiter         : uname;
  @AbapCatalog.column.multitenancyType : #NONE
  notiz              : abap.string(0);

  " Metadaten
  erstellt_am        : dats;
  erstellt_um        : tims;
  erstellt_von       : uname;

}
